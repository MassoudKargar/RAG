# API Keys (replace with your actual keys)
OPENAI_API_KEY=your_openai_api_key_here
AVALAI_API_KEY=your_avalai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# API Configuration
AVALAI_BASE_URL=https://api.avalapis.ir/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PROVIDER=openai

# Model Configuration
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# RAG Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
RAG_SEARCH_LIMIT=3
SYSTEM_PROMPT="You are a helpful assistant. Use the provided context to answer the user's question. If the context is not relevant, just say 'I don't know'"

# ---------------------------------------------------------------------
# Local Embedding microservice (Persian model) — optional, separate process
# ---------------------------------------------------------------------
# Run the embedding service in its OWN venv (separate packages) — see
# embedding_service/requirements.txt and embedding_service/main.py:
#   embedding_service/.venv/bin/uvicorn embedding_service.main:app --host 127.0.0.1 --port 8010
#
# Then, to decouple embeddings from your chat provider (e.g. chat via
# OpenRouter while embedding locally with the Persian GTE model), set:
# EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_API_URL=http://127.0.0.1:8010/embed
# LOCAL_EMBEDDING_MODEL=xmanii/maux-gte-persian
#
# When EMBEDDING_PROVIDER is unset/empty, embeddings follow PROVIDER
# (e.g. openrouter -> uses OpenRouter embeddings) for backward compatibility.
