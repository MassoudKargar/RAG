  "resources": [
    {
      "_type": "workspace",
      "_id": "wrk_rag_main",
      "name": "Maux RAG API — full test (production)",
      "description": "Complete retrieval + chat test collection against rag.masoudkargar.com (production).\n\nSETUP (once):\n1. Open Environment (Ctrl/Cmd+E), select environment \"Production\"\n2. Paste your RAG API key into `apiKey` (from /var/rag_app/.env RAG_API_KEY)\n3. baseUrl is already https://rag.masoudkargar.com — hit Send on anything.\n\nIMPORTANT: all paths have NO trailing slash. /v1/vector_db/search_documents (not .../)\nThe /docs endpoint is the interactive Swagger UI (HTML is normal there).",
      "scope": "collection"
    },
    {
      "_type": "environment",
      "_id": "env_rag_base",
      "parentId": "wsr_rag_main",
      "name": "Base Environment",
      "data": {},
      "isPrivate": false
    },
    {
      "_type": "environment",
      "_id": "env_rag_prod",
      "parentId": "ws_rag_main",
      "name": "Production",
      "data": {
        "baseUrl": "https://rag.masoudkargar.com",
        "api_key": "",
        "chat_model": "deepseek/deepseek-v4-flash-0731"
      },
      "color": "#7d69cb"
    },
    {
      "_type": "request_group",
      "_id": "grp_rag_health",
      "name": "1. Health",
      "parentId": "ws_rag_main"
    },
    {
      "_type": "request",
      "_id": "req_health",
      "parentId": "grp_rag_health",
      "name": "Health check",
      "method": "GET",
      "url": "{{ baseUrl }}/v1/health",
      "headers": [
        { "name": "X-API-Key", "value": "{{ api_key }}" }
      ],
      "body": {},
      "metaSortKey": -100
    },
    {
      "_type": "request",
      "_id": "req_root",
      "parentId": "grp_rag_health",
      "name": "Root (welcome)",
      "method": "GET",
      "url": "{{ baseUrl }}/",
      "headers": [
        { "name": "X-API-KEY", "value": "{{ api_key }}" }
      ],
      "body": {},
      "metaSortKey": -99
    },
    {
      "_type": "request_group",
      "_id": "grp_rag_retrieval",
      "name": "2. Retrieval (exact-value queries)",
      "parentId": "ws_rag_main"
    },
    {
      "_type": "request",
      "_id": "req_search_net_income",
      "parentId": "grp_rag_retrieval",
      "name": "net income FY2024",
      "method": "POST",
      "url": "{{ baseUrl }}/v1/vector_db/search_documents?limit=10",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-API-Key", "value": "{{ api_key }}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"prompt\": \"Microsoft net income fiscal year 2024\"\n}"
      }
    },
    {
      "_type": "request",
      "_id": "req_search_revenue_persian",
      "parentId": "grp_rag_retrieval",
      "name": "درآمد ۲۰۲۵ (persian)",
      "method": "POST",
      "url": "{{ baseUrl }}/v1/vector_db/search_documents?limit=10",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-API-Key", "value": "{{ api_key }}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"prompt\": \"درآمد مایکروسافت در سال مالی ۲۰۲۵ چه مقدار بود؟\"\n}"
      }
    },
    {
      "_type": "request",
      "_id": "req_search_multiyear",
      "parentId": "grp_rag_retrieval",
      "name": "multiyear (2022-2026)",
      "method": "POST",
      "url": "{{ baseUrl }}/v1/vector_db/search_documents?limit=15",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-API-Key", "value": "{{ api_key }}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"prompt\": \"Microsoft revenue from fiscal 2022 through fiscal 2026\"\n}"
      }
    },
    {
      "_type": "request",
      "_id": "req_search_balance",
      "parentId": "grp_rag_retrieval",
      "name": "balance sheet total assets FY2024",
      "method": "POST",
      "url": "{{ baseUrl }}/v1/vector_db/search_documents?limit=8",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-API-Key", "value": "{{ api_key }}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"prompt\": \"What were Microsoft's total assets in fiscal year 2024?\"\n}"
      }
    },
    {
      "_type": "request",
      "_id": "req_search_negative",
      "parentId": "grp_rag_retrieval",
      "name": "negative (other company → empty)",
      "method": "POST",
      "url": "{{ baseUrl }}/v1/vector_db/search_documents?limit=5",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-API-Key", "value": "{{ api_key }}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"prompt\": \"Apple's revenue in fiscal year 2024\"\n}"
      }
    },
    {
      "_type": "request_group",
      "_id": "grp_rag_chat",
      "name": "3. Chat completions",
      "parentId": "ws_rag_main"
    },
    {
      "_type": "request",
      "_id": "req_chat_completion",
      "parentId": "grp_rag_chat",
      "name": "chat/completions (non-stream)",
      "method": "POST",
      "url": "{{ baseUrl }}/v1/chat/completions",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-API-Key", "value": "{{ api_key }}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"model\": \"{{ chat_model }}\",\n  \"stream\": false,\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"What was Microsoft's net income in fiscal year 2024?\" }\n  ]\n}"
      }
    },
    {
      "_type": "request",
      "_id": "req_chat_stream",
      "parentId": "grp_rag_chat",
      "name": "chat/completions (stream)",
      "method": "POST",
      "url": "{{ baseUrl }}/v1/chat/completions",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-API-Key", "value": "{{ api_key }}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"model\": \"{{ chat_model }}\",\n  \"stream\": true,\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"What was Microsoft's total revenue in fiscal year 2025?\" }\n  ]\n}"
      }
    },
    {
      "_type": "request_group",
      "_id": "grp_rag_analysis",
      "name": "4. Analysis",
      "parentId": "ws_rag_main"
    },
    {
      "_type": "request",
      "_id": "req_analysis_status",
      "parentId": "grp_rag_analysis",
      "name": "analysis/status",
      "method": "GET",
      "url": "{{ baseUrl }}/v1/analysis/status",
      "headers": [
        { "name": "X-API-Key", "value": "{{ api_key }}" }
      ],
      "body": {}
    },
    {
      "_type": "request",
      "_id": "req_analysis_query",
      "parentId": "grp_rag_analysis",
      "name": "analysis/query",
      "method": "POST",
      "url": "{{ baseUrl }}/v1/analysis/query?query=What%20was%20Microsoft%27s%20net%20income%20in%20fiscal%20year%202024%3F&use_rag=true",
      "headers": [
        { "name": "X-API-Key", "value": "{{ api_key }}" }
      ],
      "body": {}
    },
    {
      "_type": "request_group",
      "_id": "grp_rag_docs",
      "name": "5. Document management",
      "parentId": "ws_rag_main"
    },
    {
      "_type": "request",
      "_id": "req_doc_upload",
      "parentId": "grp_rag_docs",
      "name": "upload document (chunked)",
      "method": "POST",
      "url": "{{ baseUrl }}/v1/vector_db/documents",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-API-Key", "value": "{{ api_key }}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"text\": \"This is a small test document about Microsoft Azure cloud services and fiscal 2024 results.\",\n  \"metadata\": {\n    \"document_id\": \"insomnia-test-001\",\n    \"topic\": \"test\"\n  }\n}"
      }
    },
    {
      "_type": "request",
      "_id": "req_doc_clear",
      "parentId": "grp_rag_docs",
      "name": "clear collection (danger)",
      "method": "DELETE",
      "url": "{{ baseUrl }}/v1/vector_db/clear_collection",
      "headers": [
        { "name": "X-API-Key", "value": "{{ api_key }}" }
      ],
      "body": {}
    }
  ]
